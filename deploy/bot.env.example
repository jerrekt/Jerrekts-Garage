# /etc/garage-bot/bot.env  (root only, mode 0600). Never commit the real one.
# Discord application: Developer Portal > your app > General Information
DISCORD_PUBLIC_KEY=
# Discord user id : first name, comma separated. Everyone who may add cars or log work.
DISCORD_USERS=
# Discord user id of the owner (approves cars, sees all cars)
GARAGE_ADMIN_ID=
GARAGE_ADMIN_NAME=Jerrekt
# Channel webhook for the feed (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=
# Public page origin allowed to read /api/public
GARAGE_ALLOWED_ORIGIN=https://garage.adsuaracloud.com
# Job kits JSON (FCP links); the repo's data/kits.json
GARAGE_KITS_PATH=/opt/garage-bot/src/data/kits.json
# Random bearer the private app sends with every request (openssl rand -hex 32)
GARAGE_SITE_TOKEN=
